              "high",
              "medium",
              "low"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "severity",
          "kind",
          "location",
          "claim",
          "evidence",
          "impact",
          "suggestion",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
