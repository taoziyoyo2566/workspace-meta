        "properties": {
          "question": {
            "type": "string",
            "enum": [
              "Q1",
              "Q2",
              "Q3",
              "Q4",
              "Q5"
            ]
          },
          "answer": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
